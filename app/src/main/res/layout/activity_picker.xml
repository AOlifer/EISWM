<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Верхняя панель: возврат, заголовок и выбор накопителя. -->
    <LinearLayout style="@style/EISWM.TopBar">

        <Button
            android:id="@+id/btnBack"
            style="@style/EISWM.TextButton"
            android:text="←  Назад" />

        <TextView
            android:id="@+id/pickerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rootsBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/btnRefresh"
            style="@style/EISWM.TextButton"
            android:text="Обновить" />
    </LinearLayout>

    <View style="@style/EISWM.Divider" />

    <!-- Путь к текущей папке: каждая часть нажимается и возвращает в эту папку. -->
    <HorizontalScrollView
        android:id="@+id/crumbsScroll"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/crumbs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="16dp" />
    </HorizontalScrollView>

    <View style="@style/EISWM.Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/pickerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View style="@style/EISWM.Divider" />

    <LinearLayout style="@style/EISWM.BottomBar">

        <TextView
            android:id="@+id/pickerStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSelectAll"
            style="@style/EISWM.TextButton"
            android:layout_marginEnd="8dp"
            android:text="Выбрать все подходящие" />

        <Button
            android:id="@+id/btnAction"
            style="@style/EISWM.PrimaryButton"
            android:text="Добавить" />
    </LinearLayout>
</LinearLayout>

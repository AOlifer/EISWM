<?xml version="1.0" encoding="utf-8"?>
<!-- Диагностика машины: журнал событий слева, действия справа. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/EISWM.TopBar">

        <Button
            android:id="@+id/btnBack"
            style="@style/EISWM.TextButton"
            android:text="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/diag_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View style="@style/EISWM.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/diagScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/surface">

            <TextView
                android:id="@+id/diagLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <View style="@style/EISWM.VDivider" />

        <ScrollView
            android:layout_width="@dimen/side_panel_width"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:fillViewport="true">

            <LinearLayout
                style="@style/EISWM.SidePanel"
                android:layout_width="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/diagStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/EISWM.Caption"
                    android:layout_marginTop="6dp"
                    android:text="@string/diag_hint" />

                <Button
                    android:id="@+id/btnRecord"
                    style="@style/EISWM.PrimaryButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/diag_record_start" />

                <Button
                    android:id="@+id/btnMark"
                    style="@style/EISWM.TextButton"
                    android:layout_width="match_parent"
                    android:text="@string/diag_mark" />

                <Button
                    android:id="@+id/btnSnapshot"
                    style="@style/EISWM.TextButton"
                    android:layout_width="match_parent"
                    android:text="@string/diag_snapshot" />

                <View
                    style="@style/EISWM.Divider"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/diagFiles"
                    style="@style/EISWM.Caption" />

                <Button
                    android:id="@+id/btnSave"
                    style="@style/EISWM.PrimaryButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/diag_save" />

                <Button
                    android:id="@+id/btnClearLog"
                    style="@style/EISWM.TextButton"
                    android:layout_width="match_parent"
                    android:text="@string/diag_clear" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>

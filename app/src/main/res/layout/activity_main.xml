<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран машины широкий (1920×720), поэтому три колонки:
    разделы слева, содержимое раздела по центру, панель действий раздела справа.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/EISWM.TopBar">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTheme"
            style="@style/EISWM.TextButton" />

        <Button
            android:id="@+id/btnHelp"
            style="@style/EISWM.TextButton"
            android:text="Справка" />

        <Button
            android:id="@+id/btnExit"
            style="@style/EISWM.TextButton"
            android:text="Выход" />
    </LinearLayout>

    <View style="@style/EISWM.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Разделы приложения; пункты создаются в MainActivity.setupSections(). -->
        <LinearLayout
            android:id="@+id/sectionRail"
            style="@style/EISWM.SidePanel"
            android:layout_width="230dp" />

        <View style="@style/EISWM.VDivider" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Раздел «Звуки приветствия». -->
            <LinearLayout
                android:id="@+id/soundsPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/surface"
                    android:orientation="vertical">

                    <TextView
                        style="@style/EISWM.SectionHeader"
                        android:text="Звуки в машине" />

                    <View style="@style/EISWM.Divider" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/soundList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <View style="@style/EISWM.VDivider" />

                <LinearLayout
                    style="@style/EISWM.SidePanel"
                    android:layout_width="360dp"
                    android:padding="16dp">

                    <TextView
                        style="@style/EISWM.Caption"
                        android:text="Звуковое приветствие" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/welcomeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/welcomeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:contentDescription="Звуковое приветствие"
                            android:scaleX="1.3"
                            android:scaleY="1.3" />
                    </LinearLayout>

                    <View
                        style="@style/EISWM.Divider"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/soundStatus"
                        style="@style/EISWM.Caption"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="10dp"
                        android:text="Машина играет звук не дольше 6 секунд: более длинный она обрывает на 6-й секунде." />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnAddSounds"
                        style="@style/EISWM.PrimaryButton"
                        android:text="+  Добавить звуки" />
                </LinearLayout>
            </LinearLayout>

            <!-- Раздел «Картинки приветствия» — место под будущее управление картинками. -->
            <LinearLayout
                android:id="@+id/picturesPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖼"
                    android:textSize="56sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Картинки приветствия"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxWidth="640dp"
                    android:text="Здесь можно будет выбирать картинки, которые машина показывает при приветствии. Раздел в разработке."
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

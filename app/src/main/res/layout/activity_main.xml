<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран машины широкий (1920×720), поэтому три колонки:
    разделы слева, содержимое раздела по центру, панель действий раздела справа.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/EISWM.TopBar">

        <!-- Логотип 2:1 на плашке его же фонового цвета; углы скругляются в MainActivity. -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/logo_bg"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_header" />

        <!-- Нажатие на логотип или название возвращает на стартовый экран. -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />


        <Button
            android:id="@+id/btnHelp"
            style="@style/EISWM.TextButton"
            android:text="@string/help" />

        <Button
            android:id="@+id/btnExit"
            style="@style/EISWM.TextButton"
            android:text="@string/exit" />
    </LinearLayout>

    <View style="@style/EISWM.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Разделы приложения и внизу кнопка темы; пункты создаются в MainActivity.setupSections(). -->
        <LinearLayout
            android:id="@+id/sectionRail"
            style="@style/EISWM.SidePanel"
            android:layout_width="120dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <View style="@style/EISWM.VDivider" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Стартовый экран: ни один раздел не выбран. -->
            <LinearLayout
                android:id="@+id/homePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="24dp">

                <!-- Размер картинки задаёт MainActivity.fitHomeImage(): окно может быть уже экрана. -->
                <ImageView
                    android:id="@+id/homeImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_card"
                    android:contentDescription="Evolute i-Space"
                    android:scaleType="fitCenter"
                    android:src="@drawable/home_car" />

                <!-- Текст прокручивается, если окно ниже экрана машины. -->
                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="40dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbarStyle="outsideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <!-- Версия и обновления: «Проверить обновления» / «Доступна версия N. Подробнее…». -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/homeVersion"
                            style="@style/EISWM.Caption"
                            android:layout_width="wrap_content"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/homeUpdate"
                            style="@style/EISWM.Caption"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="20dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:text="@string/update_check"
                            android:textColor="@color/accent"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="16dp"
                        android:text="@string/home_description"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/homeSounds"
                            style="@style/EISWM.PrimaryButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="16dp"
                            android:text="@string/home_open_sounds" />

                        <Button
                            android:id="@+id/homePictures"
                            style="@style/EISWM.PrimaryButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="16dp"
                            android:text="@string/home_open_pictures" />

                        <Button
                            android:id="@+id/homeSummary"
                            style="@style/EISWM.PrimaryButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/home_open_summary" />
                    </LinearLayout>

                    <TextView
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="16dp"
                        android:text="@string/home_developer" />
                </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- Раздел «Звуки»: вкладки «Приветствие» и «Прощание». -->
            <LinearLayout
                android:id="@+id/soundsPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/surface"
                    android:orientation="vertical">

                    <!-- Вкладки «Приветствие | Прощание»: создаются в SectionTabs. -->
                    <LinearLayout
                        android:id="@+id/soundsTabs"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <View style="@style/EISWM.Divider" />

                    <!-- Вкладка «Приветствие»: логика в SoundsPanel. -->
                    <LinearLayout
                        android:id="@+id/soundsWelcomeContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/EISWM.SectionHeader"
                            android:text="@string/sounds_header" />
    
                        <View style="@style/EISWM.Divider" />
    
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">
    
                            <LinearLayout
                                android:id="@+id/soundList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>
                    </LinearLayout>

                    <!-- Вкладка «Прощание»: список заполняет FarewellTab. -->
                    <LinearLayout
                        android:id="@+id/soundsFarewellContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/EISWM.SectionHeader"
                            android:text="@string/farewell_sounds_header" />

                        <View style="@style/EISWM.Divider" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:id="@+id/farewellSoundList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/EISWM.VDivider" />

                <!-- Прокрутка нужна, только если окно ниже экрана машины. -->
                <ScrollView
                    android:id="@+id/soundsWelcomeSide"
                    android:layout_width="@dimen/side_panel_width"
                    android:layout_height="match_parent"
                    android:background="@color/background"
                    android:fillViewport="true">

                <LinearLayout
                    style="@style/EISWM.SidePanel"
                    android:layout_width="match_parent"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/welcomeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/welcomeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/sounds_switch_desc"
                            android:scaleX="1.3"
                            android:scaleY="1.3" />
                    </LinearLayout>

                    <!-- Показывается, когда приветствие выключено. -->
                    <TextView
                        android:id="@+id/welcomeWarning"
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="2dp"
                        android:text="@string/sounds_off_warning"
                        android:textColor="@color/pill_warn_fg"
                        android:visibility="gone" />

                    <View
                        style="@style/EISWM.Divider"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/soundStatus"
                        style="@style/EISWM.Caption"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="10dp"
                        android:text="@string/sounds_tip" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnAddSounds"
                        style="@style/EISWM.PrimaryButton"
                        android:text="@string/sounds_add" />
                </LinearLayout>
                </ScrollView>

                <!-- Правая панель вкладки «Прощание». -->
                <ScrollView
                    android:id="@+id/soundsFarewellSide"
                    android:layout_width="@dimen/side_panel_width"
                    android:layout_height="match_parent"
                    android:background="@color/background"
                    android:fillViewport="true"
                    android:visibility="gone">

                <LinearLayout
                    style="@style/EISWM.SidePanel"
                    android:layout_width="match_parent"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/farewellSoundLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/farewellSoundSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/farewell_sound_switch_desc"
                            android:scaleX="1.3"
                            android:scaleY="1.3" />
                    </LinearLayout>

                    <View
                        style="@style/EISWM.Divider"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/farewellSoundStatus"
                        style="@style/EISWM.Caption"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="10dp"
                        android:text="@string/farewell_sounds_tip" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnFarewellSoundTest"
                        style="@style/EISWM.TextButton"
                        android:layout_width="match_parent"
                        android:text="@string/farewell_test_sound" />

                    <Button
                        android:id="@+id/btnFarewellSoundAdd"
                        style="@style/EISWM.PrimaryButton"
                        android:text="@string/sounds_add" />
                </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- Раздел «Картинки»: вкладки «Приветствие» (PicturesPanel) и «Прощание» (FarewellTab). -->
            <LinearLayout
                android:id="@+id/picturesPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/surface"
                    android:orientation="vertical">

                    <!-- Вкладки «Приветствие | Прощание»: создаются в SectionTabs. -->
                    <LinearLayout
                        android:id="@+id/picturesTabs"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <View style="@style/EISWM.Divider" />

                    <!-- Вкладка «Приветствие»: логика в PicturesPanel. -->
                    <LinearLayout
                        android:id="@+id/picturesWelcomeContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Заголовок и действия с выделенными картинками. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@color/surface"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingEnd="8dp">
    
                            <TextView
                                android:id="@+id/picturesHeader"
                                style="@style/EISWM.SectionHeader"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:singleLine="true"
                                android:text="@string/pictures_header" />
    
                            <!-- «Удалить» появляется слева от остальных кнопок и сжимает заголовок,
                                 поэтому «Выделить все» и «Очистить» не сдвигаются. Пока ничего не
                                 выделено, он скрыт совсем, чтобы в узком окне заголовку хватало места. -->
                            <Button
                                android:id="@+id/btnPicturesDelete"
                                style="@style/EISWM.TextButton"
                                android:layout_height="48dp"
                                android:layout_marginEnd="16dp"
                                android:textColor="@color/pill_bad_fg"
                                android:visibility="invisible" />
    
                            <Button
                                android:id="@+id/btnPicturesSelectAll"
                                style="@style/EISWM.TextButton"
                                android:layout_height="48dp"
                                android:text="@string/select_all" />
    
                            <Button
                                android:id="@+id/btnPicturesClear"
                                style="@style/EISWM.TextButton"
                                android:layout_height="48dp"
                                android:text="@string/clear_selection" />
                        </LinearLayout>
    
                        <View style="@style/EISWM.Divider" />
    
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">
    
                            <!-- Сетка превью: строки по две карточки создаются в коде. -->
                            <LinearLayout
                                android:id="@+id/pictureGrid"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="8dp" />
                        </ScrollView>
                    </LinearLayout>

                    <!-- Вкладка «Прощание»: список заполняет FarewellTab. -->
                    <LinearLayout
                        android:id="@+id/picturesFarewellContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/EISWM.SectionHeader"
                            android:text="@string/farewell_pictures_header" />

                        <View style="@style/EISWM.Divider" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:id="@+id/farewellPictureList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/EISWM.VDivider" />

                <!-- Прокрутка нужна, только если окно ниже экрана машины. -->
                <ScrollView
                    android:id="@+id/picturesWelcomeSide"
                    android:layout_width="@dimen/side_panel_width"
                    android:layout_height="match_parent"
                    android:background="@color/background"
                    android:fillViewport="true">

                <LinearLayout
                    style="@style/EISWM.SidePanel"
                    android:layout_width="match_parent"
                    android:padding="16dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/picturesLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/picturesSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/pictures_switch_caption"
                            android:scaleX="1.3"
                            android:scaleY="1.3" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/picturesWarning"
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="2dp"
                        android:text="@string/pictures_off_warning"
                        android:textColor="@color/pill_warn_fg"
                        android:visibility="gone" />

                    <View
                        style="@style/EISWM.Divider"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/picturesStatus"
                        style="@style/EISWM.Caption"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="10dp"
                        android:text="@string/pictures_tip" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnStandardPictures"
                        style="@style/EISWM.TextButton"
                        android:layout_width="match_parent"
                        android:text="@string/pictures_standard" />

                    <Button
                        android:id="@+id/btnAddPictures"
                        style="@style/EISWM.PrimaryButton"
                        android:text="@string/pictures_add" />
                </LinearLayout>
                </ScrollView>

                <!-- Правая панель вкладки «Прощание». -->
                <ScrollView
                    android:id="@+id/picturesFarewellSide"
                    android:layout_width="@dimen/side_panel_width"
                    android:layout_height="match_parent"
                    android:background="@color/background"
                    android:fillViewport="true"
                    android:visibility="gone">

                <LinearLayout
                    style="@style/EISWM.SidePanel"
                    android:layout_width="match_parent"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/farewellPictureLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/farewellPictureSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/farewell_picture_switch_desc"
                            android:scaleX="1.3"
                            android:scaleY="1.3" />
                    </LinearLayout>

                    <View
                        style="@style/EISWM.Divider"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/farewellPictureStatus"
                        style="@style/EISWM.Caption"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/EISWM.Caption"
                        android:layout_marginTop="10dp"
                        android:text="@string/farewell_pictures_tip" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnFarewellPictureTest"
                        style="@style/EISWM.TextButton"
                        android:layout_width="match_parent"
                        android:text="@string/farewell_test_picture" />

                    <Button
                        android:id="@+id/btnFarewellPictureAdd"
                        style="@style/EISWM.PrimaryButton"
                        android:text="@string/pictures_add" />
                </LinearLayout>
                </ScrollView>
            </LinearLayout>
            <!-- Раздел «Сводка»: вкладки «Приветствие» и «Прощание»; логика в SummarySection. -->
            <LinearLayout
                android:id="@+id/summaryPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/surface"
                    android:orientation="vertical">

                    <!-- Вкладки «Приветствие | Прощание»: создаются в SectionTabs. -->
                    <LinearLayout
                        android:id="@+id/summaryTabs"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <View style="@style/EISWM.Divider" />

                    <LinearLayout
                        android:id="@+id/summaryWelcomeContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <!-- Пункты: галочка, образец плашки, ▶, ручка ≡ для перетаскивания. -->
                            <LinearLayout
                                android:id="@+id/summaryWelcomeList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/summaryFarewellContent"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <!-- Пункты: галочка, образец плашки, ▶, ручка ≡ для перетаскивания. -->
                            <LinearLayout
                                android:id="@+id/summaryFarewellList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>
                    </LinearLayout>
                </LinearLayout>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Верхняя панель: разделы приложения, справка и выход. -->
    <LinearLayout style="@style/EISWM.TopBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="EISWM"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabSounds"
            style="@style/EISWM.Tab"
            android:text="Звуки" />

        <TextView
            android:id="@+id/tabPictures"
            style="@style/EISWM.Tab"
            android:text="Картинки" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnHelp"
            style="@style/EISWM.TextButton"
            android:text="Справка" />

        <Button
            android:id="@+id/btnExit"
            style="@style/EISWM.TextButton"
            android:text="Выход" />
    </LinearLayout>

    <View style="@style/EISWM.Divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Раздел «Звуки»: файлы, которые машина проигрывает при приветствии. -->
        <LinearLayout
            android:id="@+id/soundsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/welcomeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <Switch
                    android:id="@+id/welcomeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:contentDescription="Звуковое приветствие"
                    android:scaleX="1.3"
                    android:scaleY="1.3" />
            </LinearLayout>

            <View style="@style/EISWM.Divider" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/surface">

                <LinearLayout
                    android:id="@+id/soundList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <View style="@style/EISWM.Divider" />

            <LinearLayout style="@style/EISWM.BottomBar">

                <TextView
                    android:id="@+id/soundStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnAddSounds"
                    style="@style/EISWM.PrimaryButton"
                    android:text="+  Добавить звуки" />
            </LinearLayout>
        </LinearLayout>

        <!-- Раздел «Картинки»: место под будущее управление картинками приветствия. -->
        <LinearLayout
            android:id="@+id/picturesPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼"
                android:textSize="56sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Картинки приветствия"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="640dp"
                android:text="Здесь можно будет выбирать картинки, которые машина показывает при приветствии. Раздел в разработке."
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

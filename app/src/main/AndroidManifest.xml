<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Сейчас доступ к памяти даёт system uid; разрешения объявлены явно на случай другой прошивки. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Восстановление картинок приветствия при старте машины (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Проверка и установка обновлений с сервера (Updater); INSTALL_PACKAGES даёт system uid. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:supportsRtl="true"
        android:theme="@style/Theme.EISWM">
        <!-- API машины (bw.car.*) из прошивки: /system/framework/BwCarProxy.jar. Без неё
             (эмулятор, другая прошивка) приложение работает, сводка показывает пример. -->
        <uses-library
            android:name="bw.car.proxy"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PickerActivity"
            android:exported="false" />
        <activity
            android:name=".StandardPicturesActivity"
            android:exported="false" />
        <service
            android:name=".CarEventsService"
            android:exported="false" />
        <!-- Загрузка и каждое пробуждение машины после сна: запуск событий машины для сводки. -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.bw.intent.action.BOOT_COMPLETED" />
                <action android:name="com.bw.intent.action.WAKEUP" />
                <action android:name="com.bw.action.LAUNCHER_BOOT_COMPLETED" />
                <action android:name="autochips.intent.action.QB_POWERON" />
                <action android:name="autochips.intent.action.PREQB_POWERON" />
                <action android:name="android.intent.action.ACTION_BOOT_IPO" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".Updater$ResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".Updater$ReplacedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

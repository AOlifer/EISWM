<?xml version="1.0" encoding="utf-8"?>
<!-- Вариант для эмулятора: образ эмулятора подписан не ключом AOSP, поэтому system uid убирается. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:remove="android:sharedUserId">
    <!-- Без system uid окна поверх экрана (картинка прощания, плашка сводки) возможны только
         с этим разрешением; выдаётся вручную: adb shell appops set com.eiswm.emulator SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application
        android:label="@string/app_name_emulator"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:label" />
</manifest>
